<UserControl x:Class="Sde.EulersIdentity.WPF.Views.PolynomialControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Sde.EulersIdentity.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">
    <Grid>
        <StackPanel>
            <Label Content="Polynomial Terms:" />
            <ItemsControl ItemsSource="{Binding Terms}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:PolynomialTermControl DataContext="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Add Term" Command="{Binding AddTermCommand}" />
            <Button Content="Remove Term" Command="{Binding RemoveTermCommand}" />

            <Label Content="Value of x:" />
            <TextBox Text="{Binding XValue, UpdateSourceTrigger=PropertyChanged}" />

            <Button Content="Evaluate" Command="{Binding EvaluateCommand}" />

            <Label Content="Result:" />
            <TextBlock Text="{Binding Result}" />
        </StackPanel>
    </Grid>
</UserControl>