<UserControl x:Class="Sde.EulersIdentity.WPF.Views.PolynomialContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Sde.EulersIdentity.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">
    <Grid>
        <StackPanel>
            <!-- Polynomial Control--> 
            <local:PolynomialControl DataContext="{Binding PolynomialControlViewModel}" />

            <!-- Input for x value--> 
            <Label Content="Value of x:" />
            <TextBox Text="{Binding XValue, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Evaluate Button--> 
            <Button Content="Evaluate" Command="{Binding EvaluateCommand}" />

            <!-- Polynomial String Representation--> 
            <Label Content="Polynomial:" />
            <TextBlock Text="{Binding PolynomialString}" />

            <!-- Evaluation Result--> 
            <Label Content="Result:" />
            <TextBlock Text="{Binding EvaluationResult}" />
        </StackPanel>
    </Grid>
</UserControl>