<UserControl x:Class="Sde.EulersIdentity.WPF.Views.PolynomialContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Sde.EulersIdentity.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">
  <Grid>
    <StackPanel>
      <!-- Polynomial Control-->
      <local:PolynomialControl DataContext="{Binding PolynomialControlViewModel}" />

      <!-- Input for x value-->
      <StackPanel Orientation="Horizontal">
        <Label 
          Content="Value of x:"
          Margin="0,0,5,0"
        />
        <TextBox
          Text="{Binding XValue, UpdateSourceTrigger=PropertyChanged}"
          Style="{StaticResource FloatingPointTextBoxStyle}"
          HorizontalAlignment="Stretch"
        />
        <Button Content="Evaluate" Command="{Binding EvaluateCommand}" />
      </StackPanel>

      <!-- Polynomial String Representation-->
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Polynomial: " FontSize="28" FontWeight="Bold" />
        <TextBlock Text="{Binding PolynomialString}" FontSize="28" FontWeight="Bold" />
      </StackPanel>

      <!-- Evaluation Result-->
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Result: " FontSize="28" FontWeight="Bold" />
        <TextBlock Text="{Binding EvaluationResult}" FontSize="28" FontWeight="Bold" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>