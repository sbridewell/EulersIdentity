<UserControl x:Class="Sde.EulersIdentity.WPF.Views.PolynomialTermContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Sde.EulersIdentity.WPF.Views"
             xmlns:conv="clr-namespace:Sde.EulersIdentity.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <conv:StringToSanitisedDoubleStringConverter x:Key="SanitisedStringConverter" />
    </UserControl.Resources>
    <Grid>
        <StackPanel Margin="10">
            <!-- PolynomialTermControl -->
            <local:PolynomialTermControl DataContext="{Binding PolynomialTerm}" />

            <!-- Grid containing the output from the PolynomialTermControl -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- String representation of the polynomial term -->
                <TextBlock Text="Polynomial Term: " VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" />
                <TextBlock 
                    x:Name="PolynomialTermTextBlock"
                    Text="{Binding PolynomialTermRepresentation}" 
                    VerticalAlignment="Center" 
                    FontWeight="Bold" 
                    Grid.Row="0" Grid.Column="1"
                    />

                <!-- User can enter a value of x here -->
                <TextBlock Text="Value of x: " VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" />
                <TextBox 
                    x:Name="XValueTextBox"
                    Style="{StaticResource FloatingPointTextBoxStyle}"
                    Text="{Binding XValue, Converter={StaticResource SanitisedStringConverter}, UpdateSourceTrigger=PropertyChanged}"
                    Grid.Row="1" Grid.Column="1"
                    />

                <!-- Display the value of the polynomial term for the given value of x -->
                <TextBlock Text="Term Value: " VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" />
                <TextBlock 
                    x:Name="TermValueTextBlock"
                    Text="{Binding TermValue}"
                    VerticalAlignment="Center" FontWeight="Bold" 
                    Grid.Row="2" Grid.Column="1"
                    />

            </Grid>

        </StackPanel>
    </Grid>
</UserControl>
