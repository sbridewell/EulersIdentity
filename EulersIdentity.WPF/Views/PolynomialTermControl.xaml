<UserControl x:Class="Sde.EulersIdentity.WPF.Views.PolynomialTermControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Sde.EulersIdentity.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Sde.EulersIdentity.WPF.Converters"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <!-- Converts between strings and floating point numbers -->
        <conv:StringToDoubleConverter x:Key="StringToDoubleConverter" />
        
        <!-- Removes invalid characters from a string which should represent a floating point number -->
        <conv:StringToSanitisedStringConverter x:Key="SanitisedStringConverter" />

        <!-- Reusable style for text boxes intended for entry of floating point numbers -->
        <!--<Style x:Key="FloatingPointTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="100" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>-->
    </UserControl.Resources>

    <Grid>
        <StackPanel Margin="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,10">
                
                <!-- Coefficient -->
                <TextBlock Text="Coefficient:" VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBox 
                    x:Name="CoefficientTextBox"
                    Style="{StaticResource FloatingPointTextBoxStyle}"
                    Text="{Binding Coefficient, Converter={StaticResource SanitisedStringConverter}, UpdateSourceTrigger=PropertyChanged}"
                    />

                <!-- Exponent -->
                <TextBlock Text="Exponent:" VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBox 
                    x:Name="ExponentTextBox"
                    Style="{StaticResource FloatingPointTextBoxStyle}"
                    Text="{Binding Exponent, Converter={StaticResource SanitisedStringConverter}, UpdateSourceTrigger=PropertyChanged}"
                    />

                <!-- TODO: value of x isn't really part of the polynomial term, once we include the term in a polynomial -->
                <!-- Value of x -->
                <!--<TextBlock Text="Value of x:" VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBox 
                    x:Name="XValueTextBox"
                    Style="{StaticResource FloatingPointTextBoxStyle}"
                    Text="{Binding XValue, Converter={StaticResource SanitisedStringConverter}, UpdateSourceTrigger=PropertyChanged}"
                    />-->

            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>